<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="inicio_bd.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1699"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="persona" custom_title="0" dock_id="1" table="4,7:mainpersona"/><dock_state state="000000ff00000000fd00000001000000020000083b000004f8fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000083b0000011e00ffffff0000083b0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="persona" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="55"/><column index="3" value="61"/><column index="4" value="71"/><column index="5" value="199"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">/* Seleccionar todos los registros de una tabla*/
SELECT * FROM persona;
/* Seleccionar algunos campos de una tabla*/
SELECT name,lastname,email FROM persona;
/* Para insertar nuevos registros en la tabla*/
INSERT INTO persona (name,lastname,dni,email) VALUES (&quot;rolando&quot;,&quot;lopez&quot;,&quot;956256&quot;,&quot;rlopez@hotmail.com&quot;);

/* Para actualizar registros de la tabla */
UPDATE persona SET name = &quot;Ana&quot;, lastname = &quot;Aparicio&quot;, dni = &quot;4545545&quot;, email = &quot;ana@hotmail.com&quot; WHERE id = 3;

/* Seleccionar items , FILTRAR por item*/
SELECT * from persona WHERE name = &quot;Ferney&quot;;

/* Seleccionar, valores distintos que el valor que doy */
SELECT * FROM persona WHERE lastname &lt;&gt; &quot;Ramos&quot;;

/* Seleccionar lo parecido con el valor que doy*/
SELECT * FROM persona WHERE lastname like &quot;Ra%&quot;;

/* Ordenar decendiente por items */
SELECT * FROM persona ORDER BY id DESC;

/* Ordenar ascediente por items */
SELECT * FROM persona ORDER BY id ASC;

/* Comando para borrar registro, recordar utilizar el where , sino borramos todos los registros */
DELETE * FROM peronsa WHERE id = 3;</sql><current_tab id="0"/></tab_sql></sqlb_project>
